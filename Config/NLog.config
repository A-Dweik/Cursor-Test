<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${currentdir}/App_Data/logs/internal-nlog.txt">

  <targets>
    <target xsi:type="File" name="allfile" fileName="${currentdir}/App_Data/logs/log-${shortdate}.log"
                layout="${longdate}|${aspnet-traceidentifier}|${aspnet-activityid}|${event-properties:item=EventId.Id}|${logger}|${uppercase:${level}}|${message} ${exception:format=ToString,StackTrace}" />
  </targets>

  <rules>
    <logger name="*" minlevel="Debug" writeTo="allfile" />
  </rules>
</nlog>
